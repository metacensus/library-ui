---
import { MetaCensusLockup } from '@metacensus/library-ui'
import { organization } from '@metacensus/library-ui/organization'
import { FOOTER_COLUMNS } from '@metacensus/library-ui/site-links'
---

<footer class="mc-footer">
  <div class="mc-footer-brand">
    <a href="/"><MetaCensusLockup /></a>
    <p class="mc-footer-tagline">
      {`© ${organization.copyrightYears} ${organization.name}.`}
    </p>
  </div>
  <div class="mc-footer-columns">
    {
      FOOTER_COLUMNS.map((column, i) => (
        <nav class="mc-footer-column" aria-labelledby={`mc-footer-column-${i}`}>
          <h2 class="mc-footer-heading" id={`mc-footer-column-${i}`}>
            {column.label}
          </h2>
          {column.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      ))
    }
  </div>
</footer>
